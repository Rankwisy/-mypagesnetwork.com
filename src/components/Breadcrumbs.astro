---
import type { Crumb } from "../lib/schema.ts";
const { items } = Astro.props as { items: Crumb[] };
---
<nav class="wrap crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>
