---
// The closing call to action: the one centred block on any page.
const {
  heading = "Tell us where you want to rank",
  text = "Send your site and your target markets. You get a written reply with what we would fix first and what it should be worth.",
  href = "/contact/",
  label = "Get a proposal",
} = Astro.props;
---
<section class="section mist closing" aria-labelledby="closing-h">
  <div class="wrap">
    <h2 id="closing-h">{heading}</h2>
    <p>{text}</p>
    <div class="actions"><a class="btn" href={href}>{label}</a></div>
  </div>
</section>
