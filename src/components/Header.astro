---
import Logo from "./Logo.astro";
import { mainNav, SITE_LANGS } from "../data/nav.ts";
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? "page" : undefined);
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand"><Logo label="MyPages home" /></a>
    <nav class="nav-desktop" aria-label="Main">
      <ul>{mainNav.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}</ul>
    </nav>
    <details class="lang">
      <summary aria-label="Language: English">EN</summary>
      <ul>
        {SITE_LANGS.map((l) => l.live
          ? <li aria-current="true"><span lang={l.code}>{l.label}</span><small>{l.code.toUpperCase()}</small></li>
          : <li class="soon"><span lang={l.code}>{l.label}</span><small>coming soon</small></li>)}
      </ul>
    </details>
    <a class="btn small header-cta" href="/contact/">Get a proposal</a>
    <details class="menu">
      <summary><span class="open-label">Menu</span><span class="close-label">Close</span></summary>
      <div class="menu-panel">
        <nav aria-label="Main">
          <ul>
            {mainNav.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
            <li><a href="/contact/" aria-current={current("/contact/")}>Contact</a></li>
          </ul>
        </nav>
        <p>French, Dutch and Spanish versions of the site are coming soon.</p>
      </div>
    </details>
  </div>
</header>
