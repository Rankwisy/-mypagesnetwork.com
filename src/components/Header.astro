---
import { existsSync } from "node:fs";
import sharp from "sharp";
import { Image } from "astro:assets";
import { mainNav } from "../data/nav.ts";
import { company } from "../data/company.ts";

// Uses public/brand/MYPAGES_Logo_Main.png once it exists, text wordmark until then.
const logoFile = "public/brand/MYPAGES_Logo_Main.png";
let logo: { width: number; height: number } | null = null;
if (existsSync(logoFile)) {
  const m = await sharp(logoFile).metadata();
  const height = 36;
  logo = { height, width: Math.round(((m.width ?? 1) / (m.height ?? 1)) * height) };
}
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${company.brand} home`}>
      {logo ? (
        <Image src="/brand/MYPAGES_Logo_Main.png" width={logo.width} height={logo.height} alt={company.brand} loading="eager" />
      ) : (
        <span class="wordmark">MY<span>PAGES</span></span>
      )}
    </a>
    <nav aria-label="Main">
      <ul>
        {mainNav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
