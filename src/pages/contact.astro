---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { company, officeOneLine, phoneHref } from "../data/company.ts";
const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const budgets = ["Under $1,000", "$1,000 to $3,000", "$3,000 to $10,000", "$10,000+ or monthly retainer", "Not sure yet"];
---
<Base
  title="Contact MYPAGES: Request an SEO Proposal"
  description="Tell us about your site, market and goals. You get a written reply with what we would fix first, how long it takes and what it costs."
  crumbs={[{ name: "Home", path: "/" }, { name: "Contact", path: "/contact/" }]}
>
  <div class="wrap">
    <header class="page-head">
      <h1>Request an SEO proposal</h1>
      <p class="lead">A few details about your site are enough. We reply in writing, usually within two business days, with a first view of priorities, scope and price.</p>
    </header>
    <div class="contact-grid">
      <form name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="form-grid">
          <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" required autocomplete="name" maxlength="120" /></div>
          <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" required autocomplete="email" maxlength="200" /></div>
        </div>
        <div class="field"><label for="c-url">Website URL</label><input id="c-url" name="website" type="url" placeholder="https://" maxlength="300" /></div>
        <div class="form-grid">
          <div class="field">
            <label for="c-service">Service</label>
            <select id="c-service" name="service">
              <option value="">Not sure yet</option>
              {services.map((s) => <option value={s.id}>{s.data.name}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="c-budget">Budget range</label>
            <select id="c-budget" name="budget">{budgets.map((b) => <option>{b}</option>)}</select>
          </div>
        </div>
        <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" required maxlength="5000" placeholder="What do you sell, in which markets, and what would a good result look like?"></textarea></div>
        <p class="muted">We use these details only to answer your request. See the <a href="/privacy/">privacy policy</a>.</p>
        <button class="btn" type="submit">Send request</button>
      </form>
      <aside>
        <h2>Direct contact</h2>
        <p><a href={`mailto:${company.email}`}>{company.email}</a><br /><a href={phoneHref}>{company.phone}</a></p>
        <h2>Registered office</h2>
        <p>{company.legalName}<br />{officeOneLine}</p>
        <p class="muted">Registered office and agent address only. Meetings by video call.</p>
      </aside>
    </div>
  </div>
</Base>

<script>
  // Prefill the service from ?service=<slug> (links from service pages).
  const slug = new URLSearchParams(location.search).get("service");
  const select = document.getElementById("c-service") as HTMLSelectElement;
  if (slug && [...select.options].some((o) => o.value === slug)) select.value = slug;
</script>

<style>
  .contact-grid { display: grid; gap: 2.5rem; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  .contact-grid aside h2 { font-size: 1.2rem; margin-top: 0.5rem; }
  @media (max-width: 760px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
