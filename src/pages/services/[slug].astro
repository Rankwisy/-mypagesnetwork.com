---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import Result from "../../components/Result.astro";
import Timeline from "../../components/Timeline.astro";
import { service, faqPage } from "../../lib/schema.ts";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const all = await getCollection("services");
const related = d.related.map((id) => {
  const s = all.find((x) => x.id === id);
  if (!s) throw new Error(`Service "${entry.id}" links to unknown service "${id}"`);
  return s;
});
const tools = await getCollection("tools");
const tool = tools.find((t) => t.data.slug === d.tool);
if (!tool) throw new Error(`Service "${entry.id}" links to unknown tool "${d.tool}"`);

const path = `/services/${entry.id}/`;
const contact = `/contact/?service=${entry.id}`;
const toolName = tool.data.h1.split(":")[0];
const price = (v: string) => (v === "TBD" ? "On request" : `From ${v}`);
const models = [
  { name: "Audit", price: d.priceFrom.audit, text: "A fixed-scope diagnosis with a prioritised action list your team can execute." },
  { name: "Project", price: d.priceFrom.project, text: "We scope, build and ship the work end to end, with a fixed price and timeline." },
  { name: "Monthly retainer", price: d.priceFrom.retainer, text: "Ongoing execution and reporting, reviewed against agreed KPIs every month." },
];
---
<Base
  title={d.title}
  description={d.description}
  crumbs={[{ name: "Home", path: "/" }, { name: "Services", path: "/services/" }, { name: d.name, path }]}
  schema={[service(d.name, d.description, path), faqPage(d.faq)]}
>
  <header class="wrap page-head grid-12">
    <div class="hero-copy">
      <h1>{d.h1}</h1>
      <p class="lead">{d.summary}</p>
      <div class="actions">
        <a class="btn" href={contact}>Get a proposal</a>
        <a class="btn secondary" href={`/tools/${tool.data.slug}/`}>Try the free {toolName}</a>
      </div>
    </div>
    <section class="svc-hero-side" aria-labelledby="deliverables">
      <h2 id="deliverables">What you get</h2>
      <ul class="ticks">{d.deliverables.map((x) => <li>{x}</li>)}</ul>
    </section>
  </header>

  <div class="wrap grid-12 section flush-top">
    <div class="svc-body">
      <article class="prose">
        <Content />
      </article>

      <section class="block" aria-labelledby="process">
        <h2 id="process">How the work runs</h2>
        <Timeline steps={d.process} />
      </section>

      <section class="block" aria-labelledby="for-who">
        <h2 id="for-who">Who it is for</h2>
        <ul class="ticks measure">{d.audience.map((x) => <li>{x}</li>)}</ul>
      </section>

      <section class="block" aria-labelledby="models">
        <h2 id="models">Engagement models</h2>
        <ul class="models">
          {models.map((m) => (
            <li>
              <div><strong>{m.name}</strong><span class="price">{price(m.price)}</span></div>
              <p>{m.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <div class="block">
        <Faq items={d.faq} />
      </div>

      <section class="block" aria-labelledby="related">
        <h2 id="related">Related services and tools</h2>
        <ul class="results">
          {related.map((r) => (
            <li><Result href={`/services/${r.id}/`} title={r.data.name} snippet={r.data.summary} /></li>
          ))}
          <li><Result href={`/tools/${tool.data.slug}/`} title={`Free tool: ${toolName}`} snippet={tool.data.cardText} /></li>
        </ul>
      </section>
    </div>

    <aside class="svc-aside" aria-label={`${d.name} pricing`}>
      <div class="sticky-box">
        <h2>{d.name}</h2>
        <dl>
          {models.map((m) => <div><dt>{m.name}</dt><dd>{price(m.price)}</dd></div>)}
        </dl>
        <a class="btn" href={contact}>Get a proposal</a>
        <p class="hint">You get a written reply with scope and price.</p>
      </div>
    </aside>
  </div>
  <Cta heading={`Talk to us about ${d.name}`} href={contact} />
</Base>
