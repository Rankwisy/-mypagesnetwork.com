---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import Result from "../../components/Result.astro";
const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const models = [
  { name: "Audit", text: "Fixed scope and fixed price. You get a ranked action list, the evidence behind each item and a walkthrough call." },
  { name: "Project", text: "A defined build: a category restructure, a programmatic page set, a migration. Scoped, priced and delivered against a timeline." },
  { name: "Monthly retainer", text: "Ongoing execution and reporting with agreed KPIs, reviewed each month. Cancel with 30 days notice." },
];
---
<Base
  title="SEO Services for E-commerce and SMBs | MYPAGES"
  description="Technical audits, e-commerce, local, programmatic and AI search SEO, link building, domain strategy and consulting. Audit, project or monthly retainer."
  crumbs={[{ name: "Home", path: "/" }, { name: "Services", path: "/services/" }]}
>
  <div class="wrap">
    <header class="page-head">
      <h1>SEO services built around revenue</h1>
      <p class="lead">
        Every engagement starts with your data and ends with a measurable change in organic sessions, rankings or orders. Most clients start with a technical audit and move to a retainer once the priorities are clear.
      </p>
    </header>
    <ul class="results cols">
      {services.map((s) => (
        <li><Result as="h2" href={`/services/${s.id}/`} title={s.data.name} snippet={s.data.summary} /></li>
      ))}
    </ul>
    <section class="block section flush-top" aria-labelledby="models-h">
      <h2 id="models-h">Three ways to work with us</h2>
      <ul class="models">
        {models.map((m) => <li><div><strong>{m.name}</strong></div><p>{m.text}</p></li>)}
      </ul>
    </section>
  </div>
  <Cta />
</Base>
