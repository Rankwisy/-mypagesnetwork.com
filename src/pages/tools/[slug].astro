---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Faq from "../../components/Faq.astro";
import Flag from "../../components/Flag.astro";
import GoogleSearchSimulator from "../../components/tools/GoogleSearchSimulator.astro";
import SearchQueryBuilder from "../../components/tools/SearchQueryBuilder.astro";
import AdsAbTest from "../../components/tools/AdsAbTest.astro";
import { softwareApp, faqPage } from "../../lib/schema.ts";
import { isearchtrends } from "../../data/nav.ts";
import { markets } from "../../data/markets.ts";

// English routes only. For /fr/, /es/, /nl/ add src/pages/[lang]/tools/[slug].astro
// that filters tools by data.lang and passes `alternates` to Base for hreflang.
export async function getStaticPaths() {
  const tools = await getCollection("tools", (t) => t.data.lang === "en");
  return tools.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const COMPONENTS = { GoogleSearchSimulator, SearchQueryBuilder, AdsAbTest };
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const services = await getCollection("services");
const upsell = services.find((s) => s.id === d.upsellService);
if (!upsell) throw new Error(`Tool "${d.slug}" upsells unknown service "${d.upsellService}"`);
const Tool = d.component ? COMPONENTS[d.component] : null;
const path = `/tools/${d.slug}/`;
const ist = isearchtrends(d.slug);
const shortName = d.h1.split(":")[0];
---
<Base
  title={d.title}
  description={d.description}
  crumbs={[{ name: "Home", path: "/" }, { name: "Free SEO tools", path: "/tools/" }, { name: shortName, path }]}
  schema={[softwareApp(shortName, d.description, path), faqPage(d.faq)]}
>
  <div class="wrap">
    <header class="page-head tool-head">
      <h1>{d.h1}</h1>
      <p class="lead">{d.description}</p>
      {d.tier === "landing" && (
        <div class="actions"><a class="btn" href={ist}>Run it on Isearchtrends</a></div>
      )}
    </header>

    {Tool && <Tool />}

    <article class="prose block">
      <Content />
    </article>

    {d.tier === "landing" && (
      <section class="block" aria-labelledby="markets">
        <h2 id="markets">Markets covered</h2>
        <p class="measure">{markets.length} markets, each with its own local Google index.</p>
        <ul class="market-grid light">
          {markets.map((m) => (
            <li><Flag code={m.flag} /><span class="code"><abbr title={m.name}>{m.code}</abbr></span><span class="langs">{m.langs.map((l) => l.name).join(", ")}</span></li>
          ))}
        </ul>
        <div class="actions"><a class="btn" href={ist}>Run it on Isearchtrends</a></div>
      </section>
    )}
  </div>

  <section class="upsell-band" aria-labelledby="upsell-h">
    <div class="wrap grid-12">
      <div class="upsell-main">
        <h2 id="upsell-h">Want us to fix it?</h2>
        <p>The tool shows you the problem. We fix it. {upsell.data.name}: {upsell.data.summary}</p>
        <div class="actions">
          <a class="btn" href={`/contact/?service=${upsell.id}`}>Get a proposal</a>
          <a class="text-link" href={`/services/${upsell.id}/`}>More on {upsell.data.name}</a>
        </div>
      </div>
      <div class="upsell-side">
        <p><strong>Go deeper with live data</strong></p>
        <p>Keyword volumes, live SERPs, domain traffic and backlinks across 20 markets on our sister platform.</p>
        <a href={ist}>Open Isearchtrends</a>
      </div>
    </div>
  </section>

  <div class="wrap section flush-top">
    <Faq items={d.faq} />
  </div>
</Base>
