---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import Result from "../../components/Result.astro";
const tools = (await getCollection("tools", (t) => t.data.lang === "en")).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { tier: "native", heading: "Run in your browser", text: "No account, no API, nothing sent to us. These tools build Google URLs locally and open them in a new tab." },
  { tier: "landing", heading: "Live SEO data", text: "Volumes, SERPs, traffic and backlinks across 20 markets, served by our sister platform Isearchtrends." },
] as const;
---
<Base
  title="Free SEO Tools: Search, Query and Ads | MYPAGES"
  description="Free SEO tools: Google search simulator by country, advanced operator query builder, Google Ads A/B preview, plus keyword, SERP, domain and backlink data."
  crumbs={[{ name: "Home", path: "/" }, { name: "Free SEO tools", path: "/tools/" }]}
>
  <div class="wrap section flush-top">
    <header class="page-head">
      <h1>Free SEO tools</h1>
      <p class="lead">The tools we use on client work every week, free to use. Check how Google looks from another country, build operator queries for audits and outreach, and preview ad copy against live results.</p>
    </header>
    {groups.map((g, i) => (
      <section class:list={{ block: i > 0 }} aria-labelledby={`g-${g.tier}`}>
        <div class="intro">
          <h2 id={`g-${g.tier}`}>{g.heading}</h2>
          <p>{g.text}</p>
        </div>
        <ul class="results">
          {tools.filter((t) => t.data.tier === g.tier).map((t) => (
            <li><Result href={`/tools/${t.data.slug}/`} title={t.data.h1.split(":")[0]} snippet={t.data.cardText} terms={[t.data.primaryKeyword]} /></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <Cta heading="Found a problem you want fixed?" text="The tools show you what is wrong. We fix it: technical faults, thin categories, weak links, lost markets." />
</Base>
